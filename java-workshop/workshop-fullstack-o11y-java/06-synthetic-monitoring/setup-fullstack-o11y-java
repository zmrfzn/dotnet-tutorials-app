#!/bin/sh
#
# Challenge 6 - Synthetic Monitoring setup
# Ensures the Java application is running so students have a live target URL
# for their Synthetic monitors.

APP_DIR="/root/java-tutorials-app"
APP_PORT=5182

cd "$APP_DIR"

if lsof -t -i:$APP_PORT > /dev/null 2>&1; then
    echo "Application already running on port $APP_PORT."
    exit 0
fi

echo "Application not running — starting it now..."

export NEW_RELIC_LOG_ENABLED=false

if [ -f "/root/newrelic/newrelic.jar" ]; then
    export JAVA_TOOL_OPTIONS="-javaagent:/root/newrelic/newrelic.jar"
fi

nohup mvn spring-boot:run > /tmp/app-ch6.log 2>&1 &

# Wait up to 120s for the app to respond
ATTEMPTS=0
until curl -s http://localhost:$APP_PORT/api/tutorials > /dev/null 2>&1; do
    ATTEMPTS=$((ATTEMPTS + 1))
    if [ $ATTEMPTS -ge 24 ]; then
        echo "Application did not start in time. Check /tmp/app-ch6.log"
        exit 1
    fi
    echo "Waiting for application... ($ATTEMPTS)"
    sleep 5
done

echo "Application started on port $APP_PORT."

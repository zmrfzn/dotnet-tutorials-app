# create new user 'newrelic' for infraagent postgres integration
cd / && sudo PGPASSWORD=root -u postgres psql -U postgres -d postgres -c "CREATE USER new_relic WITH PASSWORD 'instruqt';" && cd -
cd / && sudo PGPASSWORD=root -u postgres psql -U postgres -d postgres -c "GRANT SELECT ON pg_stat_database TO new_relic;GRANT SELECT ON pg_stat_database_conflicts TO new_relic;GRANT SELECT ON pg_stat_bgwriter TO new_relic;GRANT SELECT ON ALL TABLES IN SCHEMA public TO new_relic;GRANT pg_read_all_stats TO new_relic;" && cd -